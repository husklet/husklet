1e300*1e-8 up          cw=083f f64=7c90088980000000 exc=20
1e-300/3 up            cw=083f f64=018c92d520000000 exc=20
1e300*1e-8 zero        cw=0c3f f64=7c90088960000000 exc=20
1e-300/3 zero          cw=0c3f f64=018c92d500000000 exc=20
