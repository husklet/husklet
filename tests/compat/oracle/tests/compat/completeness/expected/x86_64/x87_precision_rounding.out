== FRNDINT and FIST already honoured RC; keep them honest
rnd near v[0] frndint=2 fistp=2 c1=0
rnd near v[1] frndint=-2 fistp=-2 c1=0
rnd near v[2] frndint=4 fistp=4 c1=1
rnd near v[3] frndint=0 fistp=0 c1=0
rnd near v[4] frndint=-0 fistp=0 c1=0
rnd near v[5] frndint=1 fistp=1 c1=0
rnd down v[0] frndint=2 fistp=2 c1=0
rnd down v[1] frndint=-3 fistp=-3 c1=1
rnd down v[2] frndint=3 fistp=3 c1=0
rnd down v[3] frndint=0 fistp=0 c1=0
rnd down v[4] frndint=-1 fistp=-1 c1=1
rnd down v[5] frndint=1 fistp=1 c1=0
