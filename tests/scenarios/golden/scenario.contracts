{"id":"dockernet/connect","image":"alpine:latest","step":{"host":"docker network create \"$NET\" >/dev/null\ndocker run -d --name ${C}c $PLAT $IMG sleep 120 >/dev/null; sleep 0.3\ndocker network connect \"$NET\" ${C}c\ndocker inspect -f \"{{range \\$k,\\$v := .NetworkSettings.Networks}}{{\\$k}} {{end}}\" ${C}c | grep -q \"$NET\" && echo CONNECTED"},"targets":["arm64"],"class":"quick","checks":[{"contains":"CONNECTED"}],"xfail":[],"timeout":40,"terminal":false}
{"id":"dockernet/create-ls","image":"alpine:latest","step":{"host":"docker network create \"$NET\" >/dev/null\ndocker network ls --format \"{{.Name}}\" | grep -q \"^${NET}$\" && echo NET_LISTED"},"targets":["arm64"],"class":"quick","checks":[{"contains":"NET_LISTED"}],"xfail":[],"timeout":40,"terminal":false}
{"id":"dockernet/create-multi-alias","image":"alpine:latest","step":{"host":"docker network create \"$NET\" >/dev/null\ndocker network create \"${NET}2\" >/dev/null\ndocker create --name ${C}srv --network \"$NET\" --network-alias front --network \"${NET}2\" --network-alias database $PLAT $IMG sh -c \"echo MULTIOK | nc -l -p 9000\" >/dev/null\ndocker create --name ${C}cli --network \"$NET\" --network \"${NET}2\" $PLAT $IMG sleep 120 >/dev/null\ndocker start ${C}srv ${C}cli >/dev/null\ndocker exec ${C}cli nc -w 3 database 9000"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"MULTIOK"}],"xfail":[],"timeout":40,"terminal":false}
{"id":"dockernet/host-mode","image":"alpine:latest","step":{"host":"docker run --rm --network host $PLAT $IMG sh -c 'test -r /etc/resolv.conf && test -s /etc/hosts && echo HOST_MODE_OK'"},"targets":["arm64"],"class":"quick","checks":[{"contains":"HOST_MODE_OK"}],"xfail":[],"timeout":40,"terminal":false}
{"id":"dockernet/inspect","image":"alpine:latest","step":{"host":"docker network create \"$NET\" >/dev/null\ndocker network inspect \"$NET\" >/dev/null 2>&1 && echo NET_INSPECT_OK"},"targets":["arm64"],"class":"quick","checks":[{"contains":"NET_INSPECT_OK"}],"xfail":[],"timeout":40,"terminal":false}
{"id":"dockernet/reach-by-name","image":"alpine:latest","step":{"host":"docker network create \"$NET\" >/dev/null\ndocker run -d --name ${C}srv --network \"$NET\" $PLAT $IMG sh -c \"while true; do echo BYNAMEOK | nc -l -p 9000 -w 1; done\" >/dev/null\nsleep 1\ndocker run --rm --network \"$NET\" $PLAT $IMG nc -w 3 ${C}srv 9000"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"BYNAMEOK"}],"xfail":[],"timeout":40,"terminal":false}
{"id":"dockernet/reach-by-name-late","image":"alpine:latest","step":{"host":"docker network create \"$NET\" >/dev/null\ndocker run -d --name ${C}cli --network \"$NET\" $PLAT $IMG sleep 120 >/dev/null\nsleep 0.5\ndocker run -d --name ${C}srv --network \"$NET\" $PLAT $IMG sh -c \"while true; do echo LATEOK | nc -l -p 9000 -w 1; done\" >/dev/null\nsleep 1.5\ndocker exec ${C}cli nc -w 3 ${C}srv 9000"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"LATEOK"}],"xfail":[],"timeout":40,"terminal":false}
{"id":"dockernet/rm","image":"alpine:latest","step":{"host":"docker network create \"${NET}2\" >/dev/null\ndocker network rm \"${NET}2\" >/dev/null\ndocker network ls --format \"{{.Name}}\" | grep -q \"^${NET}2$\" && echo STILL || echo NET_REMOVED"},"targets":["arm64"],"class":"quick","checks":[{"contains":"NET_REMOVED"}],"xfail":[],"timeout":40,"terminal":false}
{"id":"dockervol/anon-volume","image":"alpine:latest","step":{"host":"docker run -d --name ${C}c $PLAT -v /data $IMG sh -c \"echo ANON > /data/f; sleep 60\" >/dev/null; sleep 0.6\ndocker exec ${C}c cat /data/f\ndocker inspect -f \"{{range .Mounts}}{{.Type}}:{{.Destination}} {{end}}\" ${C}c | grep -q \"volume:/data\" && echo ANON_IS_VOLUME"},"targets":["arm64"],"class":"quick","checks":[{"contains":"ANON"},{"contains":"ANON_IS_VOLUME"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/bind-nonrecursive-reject","image":"alpine:latest","step":{"host":"! docker create --mount type=bind,source=$WORK,destination=/data,bind-nonrecursive $PLAT $IMG true >/dev/null 2>&1 && echo NONRECURSIVE_REJECT_OK"},"targets":["arm64"],"class":"quick","checks":[{"contains":"NONRECURSIVE_REJECT_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/bind-private-recursive-ro","image":"alpine:latest","step":{"host":"mkdir -p $WORK/nested\ndocker run --rm --mount type=bind,source=$WORK,destination=/data,readonly,bind-propagation=private $PLAT $IMG sh -c 'echo x > /data/nested/x 2>/dev/null || echo RECURSIVE_RO_OK'"},"targets":["arm64"],"class":"quick","checks":[{"contains":"RECURSIVE_RO_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/bind-shared-reject","image":"alpine:latest","step":{"host":"! docker create --mount type=bind,source=$WORK,destination=/data,bind-propagation=rshared $PLAT $IMG true >/dev/null 2>&1 && echo SHARED_REJECT_OK"},"targets":["arm64"],"class":"quick","checks":[{"contains":"SHARED_REJECT_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/create-ls","image":"alpine:latest","step":{"host":"docker volume create ${C}v >/dev/null\ndocker volume ls --format \"{{.Name}}\" | grep -q \"^${C}v$\" && echo VOL_LISTED\ndocker volume rm ${C}v >/dev/null 2>&1"},"targets":["arm64"],"class":"quick","checks":[{"contains":"VOL_LISTED"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/inspect","image":"alpine:latest","step":{"host":"docker volume create ${C}v >/dev/null\ndocker volume inspect ${C}v >/dev/null 2>&1 && echo VOL_INSPECT_OK\ndocker volume rm ${C}v >/dev/null 2>&1"},"targets":["arm64"],"class":"quick","checks":[{"contains":"VOL_INSPECT_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/local-bind","image":"alpine:latest","step":{"host":"mkdir -p $WORK/device; echo LOCAL_BIND_OK > $WORK/device/value\ndocker volume create --driver local --opt type=none --opt o=bind --opt device=$WORK/device ${C}v >/dev/null\ndocker run --rm $PLAT -v ${C}v:/data $IMG cat /data/value\ndocker volume rm ${C}v >/dev/null; test -f $WORK/device/value"},"targets":["arm64"],"class":"quick","checks":[{"contains":"LOCAL_BIND_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/local-bind-inspect","image":"alpine:latest","step":{"host":"mkdir -p $WORK/device\ndocker volume create --driver local --opt type=none --opt o=bind,ro --opt device=$WORK/device ${C}v >/dev/null\ndocker volume inspect -f '{{.Driver}} {{.Scope}} {{index .Options \"type\"}} {{index .Options \"o\"}}' ${C}v\ndocker volume rm ${C}v >/dev/null"},"targets":["arm64"],"class":"quick","checks":[{"contains":"local local none bind,ro"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/local-filesystem-reject","image":"alpine:latest","step":{"host":"mkdir -p $WORK/device\n! docker volume create --driver local --opt type=ext4 --opt o=bind --opt device=$WORK/device ${C}v >/dev/null 2>&1 && echo LOCAL_FS_REJECT_OK"},"targets":["arm64"],"class":"quick","checks":[{"contains":"LOCAL_FS_REJECT_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/mount-tmpfs","image":"alpine:latest","step":{"host":"docker run -d --name ${C}c $PLAT --mount type=tmpfs,destination=/scratch $IMG sleep 60 >/dev/null; sleep 0.4\ndocker exec ${C}c sh -c \"echo ok > /scratch/f && cat /scratch/f\"\ndocker inspect -f \"{{range .Mounts}}{{.Type}} {{.Destination}}{{end}}\" ${C}c"},"targets":["arm64"],"class":"quick","checks":[{"contains":"ok"},{"contains":"tmpfs /scratch"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/mount-volume-inuse","image":"alpine:latest","step":{"host":"docker volume create ${C}v >/dev/null\ndocker run -d --name ${C}c $PLAT --mount type=volume,source=${C}v,destination=/data $IMG sleep 60 >/dev/null; sleep 0.5\ndocker volume rm ${C}v 2>&1 | grep -qi \"in use\\|cannot\" && echo IN_USE\ndocker rm -f ${C}c >/dev/null; docker volume rm ${C}v >/dev/null 2>&1"},"targets":["arm64"],"class":"quick","checks":[{"contains":"IN_USE"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/persist-across-runs","image":"alpine:latest","step":{"host":"docker volume create ${C}v >/dev/null\ndocker run --rm $PLAT -v ${C}v:/data $IMG sh -c \"echo VOLPERSIST > /data/f\"\ndocker run --rm $PLAT -v ${C}v:/data $IMG cat /data/f\ndocker volume rm ${C}v >/dev/null 2>&1"},"targets":["arm64"],"class":"quick","checks":[{"contains":"VOLPERSIST"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/rm","image":"alpine:latest","step":{"host":"docker volume create ${C}v >/dev/null\ndocker volume rm ${C}v >/dev/null\ndocker volume ls --format \"{{.Name}}\" | grep -q \"^${C}v$\" && echo STILL || echo VOL_REMOVED"},"targets":["arm64"],"class":"quick","checks":[{"contains":"VOL_REMOVED"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/subpath","image":"alpine:latest","step":{"host":"docker volume create ${C}v >/dev/null\ndocker run --rm -v ${C}v:/seed $PLAT $IMG sh -c 'mkdir -p /seed/safe && echo SUBPATH_OK > /seed/safe/value'\ndocker run --rm --mount type=volume,source=${C}v,destination=/data,volume-subpath=safe,readonly $PLAT $IMG cat /data/value"},"targets":["arm64"],"class":"quick","checks":[{"contains":"SUBPATH_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/subpath-missing","image":"alpine:latest","step":{"host":"docker volume create ${C}v >/dev/null\n! docker run --rm --mount type=volume,source=${C}v,destination=/data,volume-subpath=missing $PLAT $IMG true >/dev/null 2>&1 && echo SUBPATH_MISSING_OK"},"targets":["arm64"],"class":"quick","checks":[{"contains":"SUBPATH_MISSING_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/subpath-symlink-escape","image":"alpine:latest","step":{"host":"docker volume create ${C}v >/dev/null\ndocker run --rm -v ${C}v:/seed $PLAT $IMG ln -s /tmp /seed/escape\n! docker run --rm --mount type=volume,source=${C}v,destination=/data,volume-subpath=escape $PLAT $IMG true >/dev/null 2>&1 && echo SUBPATH_ESCAPE_OK"},"targets":["arm64"],"class":"quick","checks":[{"contains":"SUBPATH_ESCAPE_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"dockervol/tmpfs-fresh","image":"alpine:latest","step":{"host":"docker run --rm $PLAT --tmpfs /cache $IMG sh -c \"echo hi > /cache/f && cat /cache/f && ls -1 /cache | wc -l | tr -d ' '\"\ndocker run --rm $PLAT --tmpfs /cache $IMG sh -c \"ls -1 /cache | wc -l | tr -d ' '\""},"targets":["arm64"],"class":"quick","checks":[{"contains":"hi"},{"contains":"1"},{"contains":"0"}],"xfail":[],"timeout":30,"terminal":false}
