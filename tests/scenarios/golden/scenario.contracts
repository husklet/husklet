{"id":"databases/mariadb-agg-1011","image":"mariadb:10.11","step":{"exec":"export MARIADB_ROOT_PASSWORD=pw\ndocker-entrypoint.sh mariadbd >/tmp/maria.log 2>&1 &\nfor i in $(seq 1 150); do grep -q 'port: 3306' /tmp/maria.log 2>/dev/null && break; sleep 1; done\nfor i in $(seq 1 30); do mariadb -uroot -ppw -N -e 'SELECT 1' >/dev/null 2>&1 && break; sleep 1; done\nmariadb -uroot -ppw -N -e \"CREATE DATABASE d; USE d; CREATE TABLE t(n INT); INSERT INTO t (n) WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM s WHERE x<1000) SELECT x FROM s; SELECT SUM(n) FROM t;\""},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"500500"}],"xfail":[],"timeout":120,"terminal":false}
