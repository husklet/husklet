{"id":"databases/redis-agg-7-alpine","image":"redis:7-alpine","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 50); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.2; done\nfor i in $(seq 1 1000); do redis-cli rpush L $i >/dev/null; done\nredis-cli eval \"local s=0 for _,v in ipairs(redis.call('lrange','L',0,-1)) do s=s+v end return s\" 0"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"500500"}],"xfail":[],"timeout":90,"terminal":false}
{"id":"databases/redis-dbsize","image":"redis:7-alpine","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 50); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.2; done\nredis-cli mset a 1 b 2 c 3 >/dev/null; redis-cli dbsize"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"3"}],"xfail":[],"timeout":60,"terminal":false}
{"id":"databases/redis-hash-hlen","image":"redis:7-alpine","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 50); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.2; done\nredis-cli hset h a 1 b 2 c 3 >/dev/null; redis-cli hlen h"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"3"}],"xfail":[],"timeout":60,"terminal":false}
{"id":"databases/redis-incr-1000","image":"redis:alpine","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 50); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.2; done\nfor i in $(seq 1 1000); do redis-cli incr c >/dev/null; done\nredis-cli get c"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"1000"}],"xfail":[],"timeout":90,"terminal":false}
{"id":"databases/redis-lua-sum","image":"redis:7-alpine","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 50); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.2; done\nredis-cli eval \"local s=0 for i=1,1000 do s=s+i end return s\" 0"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"500500"}],"xfail":[],"timeout":60,"terminal":false}
{"id":"databases/redis-ping-glibc","image":"redis:7","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 50); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.2; done\nredis-cli ping"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"PONG"}],"xfail":[],"timeout":60,"terminal":false}
{"id":"databases/redis-roundtrip","image":"redis:alpine","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 50); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.2; done\nredis-cli ping; redis-cli set k hello-redis >/dev/null; redis-cli get k"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"PONG"},{"contains":"hello-redis"}],"xfail":[],"timeout":60,"terminal":false}
{"id":"databases/redis-setget-74","image":"redis:7.4-alpine","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 50); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.2; done\nredis-cli set k dd-value-42 >/dev/null; redis-cli get k"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"dd-value-42"}],"xfail":[],"timeout":60,"terminal":false}
