{"id":"weird/prctl-name","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <sys/prctl.h>\nint main(){\n  prctl(PR_SET_NAME,\"hl-proc\");\n  char n[16]={0}; prctl(PR_GET_NAME,n);\n  printf(\"PRCTL=%s\\n\",n); return 0;\n}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"PRCTL=hl-proc"}],"xfail":[],"timeout":120,"terminal":false}
