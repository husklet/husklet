{"id":"utilities/truncate-shrink","image":"alpine:3.24.1","step":{"exec":"rm -f /tmp/ts0; printf 0123456789 > /tmp/ts0; truncate -s 4 /tmp/ts0; cat /tmp/ts0; echo"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"0123"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-big-pipe","image":"ubuntu:24.04","step":{"exec":"seq 2000000 | wc -l"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"2000000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-brace-jobs","image":"ubuntu:24.04","step":{"exec":"bash -c 'for i in {1..8}; do (echo x) & done; wait; echo done8'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"done8"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-date-epoch-zero","image":"ubuntu:24.04","step":{"exec":"date -u -d @0 +%Y-%m-%d"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"1970-01-01"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-date-parse-epoch","image":"ubuntu:24.04","step":{"exec":"date -u -d '2000-01-01 12:00:00' +%s"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"946728000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-dd-copy-bytes","image":"ubuntu:24.04","step":{"exec":"dd if=/dev/zero bs=1000 count=5 2>/dev/null | wc -c"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"5000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-du-apparent-size","image":"ubuntu:24.04","step":{"exec":"printf 0123456789 > /tmp/du; du --apparent-size -b /tmp/du | cut -f1"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"10"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-factor-semicolon","image":"ubuntu:24.04","step":{"exec":"factor 91"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"91: 7 13"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-fallocate","image":"ubuntu:24.04","step":{"exec":"rm -f /tmp/fa; fallocate -l 8192 /tmp/fa; stat -c %s /tmp/fa"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"8192"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-flock","image":"ubuntu:24.04","step":{"exec":"flock /tmp/lkx -c 'echo locked'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"locked"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-flock-w","image":"ubuntu:24.04","step":{"exec":"flock -w 2 /tmp/lkw -c 'echo flock-w-ok'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"flock-w-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-fmt-width","image":"ubuntu:24.04","step":{"exec":"printf 'aa bb cc dd ee ff\\n' | fmt -w 8 | head -1"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"aa bb"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-getconf-longbit","image":"ubuntu:24.04","step":{"exec":"getconf LONG_BIT"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"64"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-getconf-openmax","image":"ubuntu:24.04","step":{"exec":"getconf OPEN_MAX | grep -qE '^[0-9]+$' && echo openmax-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"openmax-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-getconf-pagesize","image":"ubuntu:24.04","step":{"exec":"getconf PAGESIZE"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"4096"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-getent-group-root","image":"ubuntu:24.04","step":{"exec":"getent group root | cut -d: -f1"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"root"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-getent-hosts","image":"ubuntu:24.04","step":{"exec":"getent hosts localhost | grep -qE '::1|127.0.0.1' && echo getent-host-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"getent-host-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-iconv-latin1","image":"ubuntu:24.04","step":{"exec":"printf 'caf\\303\\251' | iconv -f utf-8 -t latin1 | iconv -f latin1 -t utf-8 | wc -c"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"5"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-iconv-roundtrip","image":"ubuntu:24.04","step":{"exec":"printf AAA | iconv -f ascii -t utf-16 | iconv -f utf-16 -t ascii"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"AAA"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-large-pipe-count","image":"ubuntu:24.04","step":{"exec":"seq 100000 | wc -l"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"100000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-ldd-version-glibc","image":"ubuntu:24.04","step":{"exec":"ldd --version | head -1"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"GLIBC"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-nl-ba-blank","image":"ubuntu:24.04","step":{"exec":"printf 'x\\n\\ny\\n' | nl -ba | awk 'NR==2{print $1}'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"2"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-nproc-all","image":"ubuntu:24.04","step":{"exec":"[ $(nproc --all) -ge 1 ] && echo nproc-all-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"nproc-all-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-nsenter-self","image":"ubuntu:24.04","step":{"exec":"readlink /proc/self/ns/pid | grep -q 'pid:\\[' && echo ns-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"ns-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-numfmt-from-iec","image":"ubuntu:24.04","step":{"exec":"numfmt --from=iec 1K"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"1024"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-numfmt-to-iec","image":"ubuntu:24.04","step":{"exec":"numfmt --to=iec 1048576"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"1.0M"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-pipefail-status","image":"ubuntu:24.04","step":{"exec":"bash -c 'set -o pipefail; (exit 42) | cat; echo rc=$?'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"rc=42"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-printf-many-args","image":"ubuntu:24.04","step":{"exec":"printf '%s+' 1 2 3 4 5; echo"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"1+2+3+4+5+"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-proc-cgroup-v2","image":"ubuntu:24.04","step":{"exec":"grep -q '^0::' /proc/self/cgroup && echo cg2-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"cg2-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-proc-limits-nofile","image":"ubuntu:24.04","step":{"exec":"grep -q 'Max open files' /proc/self/limits && echo limits-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"limits-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-proc-maps-exec","image":"ubuntu:24.04","step":{"exec":"grep -q r-xp /proc/self/maps && echo maps-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"maps-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-proc-stat-comm","image":"ubuntu:24.04","step":{"exec":"cat /proc/self/stat | sed 's/.*(\\(.*\\)).*/\\1/'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"cat"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-proc-status-vmrss","image":"ubuntu:24.04","step":{"exec":"grep -q VmRSS /proc/self/status && echo status-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"status-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-read-timeout","image":"ubuntu:24.04","step":{"exec":"bash -c 'read -t 1 x < <(sleep 5); echo rc=$?'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"rc=1"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-seq-width","image":"ubuntu:24.04","step":{"exec":"seq -w 8 11 | paste -sd, -"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"08,09,10,11"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-sha256-big","image":"ubuntu:24.04","step":{"exec":"head -c 1048576 /dev/zero | sha256sum | cut -d' ' -f1"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"30e14955ebf1352266dc2ff8067e68104607e750abb9d3b36582b8af909fcb58"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-sort-version","image":"ubuntu:24.04","step":{"exec":"printf '10\\n9\\n100\\n' | sort --version-sort | paste -sd, -"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"9,10,100"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-stat-format-octal","image":"ubuntu:24.04","step":{"exec":"install -m 640 /dev/null /tmp/pf; stat --format=%a /tmp/pf"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"640"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-stat-format-size","image":"ubuntu:24.04","step":{"exec":"printf abcde > /tmp/sf; stat --format=%s /tmp/sf"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"5"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-tar-gzip-list","image":"ubuntu:24.04","step":{"exec":"cd /tmp && rm -rf ug ug.tgz && mkdir ug && seq 1 2000 > ug/n && tar czf ug.tgz ug && tar tzf ug.tgz | grep ug/n"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"ug/n"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-taskset","image":"ubuntu:24.04","step":{"exec":"taskset -c 0 sh -c 'echo pinned'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"pinned"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-truncate-size","image":"ubuntu:24.04","step":{"exec":"truncate -s 8192 /tmp/tr8; stat --format=%s /tmp/tr8"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"8192"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-ulimit-nofile","image":"ubuntu:24.04","step":{"exec":"ulimit -n | grep -qE '^[0-9]+$|unlimited' && echo nofile-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"nofile-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ubuntu-wc-m","image":"ubuntu:24.04","step":{"exec":"printf '\\303\\251\\303\\251' | LC_ALL=C.UTF-8 wc -m"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"2"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ulimit-cpu-unlimited","image":"alpine:3.24.1","step":{"exec":"sh -c 'ulimit -t unlimited; echo ok'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ulimit-nofile","image":"alpine:3.24.1","step":{"exec":"ulimit -n | grep -qE '^[0-9]+$|unlimited' && echo nofile-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"nofile-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/ulimit-stack","image":"alpine:3.24.1","step":{"exec":"ulimit -s | grep -qE '^[0-9]+$|unlimited' && echo stack-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"stack-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/umask-default","image":"alpine:3.24.1","step":{"exec":"umask"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"0022"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/uname-linux","image":"alpine:3.24.1","step":{"exec":"uname -s"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"Linux"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/uniq-count","image":"alpine:3.24.1","step":{"exec":"printf 'a\\na\\nb\\n' | uniq -c | awk 'NR==1{print $1}'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"2"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/unset-cross","image":"alpine:3.24.1","step":{"exec":"XV=hi; unset XV; echo \"[${XV:-gone}]\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"[gone]"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/uptime-mono","image":"alpine:3.24.1","step":{"exec":"a=$(cut -d. -f1 /proc/uptime); sleep 1; b=$(cut -d. -f1 /proc/uptime); [ $b -ge $a ] && echo mono-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"mono-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/urandom","image":"alpine:3.24.1","step":{"exec":"head -c 16 /dev/urandom | wc -c"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"16"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/wait-many","image":"alpine:3.24.1","step":{"exec":"for i in 1 2 3 4 5; do (echo j$i) & done; wait; echo all-done"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"all-done"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/wc-chars","image":"alpine:3.24.1","step":{"exec":"printf abc | wc -c"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"3"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/wc-lines","image":"alpine:3.24.1","step":{"exec":"seq 1 100 | wc -l"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"100"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/wc-words","image":"alpine:3.24.1","step":{"exec":"echo 'one two three' | wc -w"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"3"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/wget-loopback","image":"busybox:latest","step":{"exec":"mkdir -p /www && echo hl-http-ok > /www/f.txt && httpd -p 127.0.0.1:8080 -h /www && sleep 0.3 && wget -qO- http://127.0.0.1:8080/f.txt"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"hl-http-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/while-read-loop","image":"alpine:3.24.1","step":{"exec":"printf 'a\\nb\\nc\\n' | while read l; do echo L:$l; done | tail -1"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"L:c"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/word-frequency","image":"alpine:3.24.1","step":{"exec":"printf 'apple\nbanana\napple\ncherry\nbanana\napple\n' | sort | uniq -c | sort -rn | awk 'NR == 1 {print $2}'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"apple"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/xargs-count","image":"alpine:3.24.1","step":{"exec":"echo 1 2 3 4 | xargs -n1 | wc -l"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"4"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/xargs-parallel","image":"alpine:3.24.1","step":{"exec":"seq 1 200 | xargs -P4 -n1 echo | wc -l"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"200"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/xargs-spawn-many","image":"alpine:3.24.1","step":{"exec":"seq 1 300 | xargs -n1 sh -c 'echo $1' _ | wc -l"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"300"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/zcat-stream","image":"alpine:3.24.1","step":{"exec":"echo zcat-ok | gzip | zcat"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"zcat-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/zero-throughput","image":"alpine:3.24.1","step":{"exec":"head -c 10485760 /dev/zero | wc -c"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"10485760"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/cmd-append-redirect","image":"alpine:latest","step":{"host":"echo one > \"$WORK/log\"\ndocker run --rm $PLAT -v \"$WORK\":/d $IMG sh -c 'echo two >> /d/log'\ntr \"\\n\" \" \" < \"$WORK/log\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"one two"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/cmd-cat-grep-wc","image":"alpine:latest","step":{"host":"printf 'apple\\nbanana\\ncherry\\n' > \"$WORK/f\"\ndocker run --rm $PLAT -v \"$WORK\":/d $IMG sh -c 'cat /d/f | grep a | wc -l | tr -d \" \"'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"2"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/cmd-chmod-perms","image":"alpine:latest","step":{"host":"echo x > \"$WORK/s\"\ndocker run --rm $PLAT -v \"$WORK\":/d $IMG sh -c 'chmod 640 /d/s && ls -l /d/s | cut -c1-10'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"-rw-r-----"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/cmd-cp-mv-rm","image":"alpine:latest","step":{"host":"echo hi > \"$WORK/a\"\ndocker run --rm $PLAT -v \"$WORK\":/d $IMG sh -c 'cp /d/a /d/b && mv /d/b /d/c && rm /d/a && ls /d | sort | tr \"\\n\" \",\"'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"c,"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/cmd-mkdir-touch-find","image":"alpine:latest","step":{"host":"docker run --rm $PLAT -v \"$WORK\":/d $IMG sh -c 'mkdir -p /d/x/y && touch /d/x/y/z.txt && find /d -name z.txt'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"/d/x/y/z.txt"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/cmd-sed-inplace","image":"alpine:latest","step":{"host":"echo 'foo=1' > \"$WORK/cfg\"\ndocker run --rm $PLAT -v \"$WORK\":/d $IMG sh -c 'sed -i s/foo/bar/ /d/cfg'\ncat \"$WORK/cfg\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"bar=1"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/cmd-sort-head-tail","image":"alpine:latest","step":{"host":"printf '3\\n1\\n2\\n' > \"$WORK/n\"\ndocker run --rm $PLAT -v \"$WORK\":/d $IMG sh -c 'echo MIN=$(sort /d/n | head -1); echo MAX=$(sort /d/n | tail -1)'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"MIN=1"},{"contains":"MAX=3"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/cmd-wc-bytes","image":"alpine:latest","step":{"host":"printf 'abcde' > \"$WORK/b\"\ndocker run --rm $PLAT -v \"$WORK\":/d $IMG sh -c 'wc -c < /d/b | tr -d \" \"'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"5"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/delete-propagates","image":"alpine:latest","step":{"host":"echo a > \"$WORK/d.txt\"\ndocker run --rm $PLAT -v \"$WORK\":/data $IMG rm /data/d.txt\ntest ! -e \"$WORK/d.txt\" && echo DELETED"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"DELETED"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/host-seen-in-container","image":"alpine:latest","step":{"host":"echo HSEED > \"$WORK/h.txt\"\ndocker run --rm $PLAT -v \"$WORK\":/data $IMG cat /data/h.txt"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"HSEED"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/nested-dotdot-crosses-boundary","image":"alpine:latest","step":{"host":"mkdir -p \"$WORK/sub\"\necho host-sibling > \"$WORK/HOSTMARK\"\ndocker run --rm $PLAT -v \"$WORK/sub\":/mnt $IMG sh -c 'ls /mnt/.. | grep -qx etc && ls /mnt/.. | grep -qx bin && echo PARENT_IS_ROOTFS; ls /mnt/.. | grep -q HOSTMARK && echo LEAKED || echo NO_LEAK'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"PARENT_IS_ROOTFS"},{"contains":"NO_LEAK"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/persist-across-runs","image":"alpine:latest","step":{"host":"docker run --rm $PLAT -v \"$WORK\":/data $IMG sh -c 'echo persisted > /data/p'\ndocker run --rm $PLAT -v \"$WORK\":/data $IMG cat /data/p"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"persisted"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/readonly-rejects-write","image":"alpine:latest","step":{"host":"docker run --rm $PLAT -v \"$WORK\":/data:ro $IMG sh -c 'echo x > /data/n 2>/dev/null || echo RO_REJECTED'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"RO_REJECTED"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/subdir-mount","image":"alpine:latest","step":{"host":"mkdir -p \"$WORK/sub\"\necho inner > \"$WORK/sub/inner.txt\"\ndocker run --rm $PLAT -v \"$WORK/sub\":/mnt $IMG sh -c 'cat /mnt/inner.txt && ls /mnt'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"inner.txt"},{"contains":"inner"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/two-mounts","image":"alpine:latest","step":{"host":"mkdir -p \"$WORK/m1\" \"$WORK/m2\"\necho one > \"$WORK/m1/a\"\necho two > \"$WORK/m2/b\"\ndocker run --rm $PLAT -v \"$WORK/m1\":/x -v \"$WORK/m2\":/y $IMG sh -c 'cat /x/a; cat /y/b'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"one"},{"contains":"two"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"volumes/write-seen-on-host","image":"alpine:latest","step":{"host":"docker run --rm $PLAT -v \"$WORK\":/data $IMG sh -c 'echo CWROTE > /data/f.txt'\ncat \"$WORK/f.txt\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"CWROTE"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/auxval-hwcap","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <sys/auxv.h>\nint main(){\n  unsigned long hw=getauxval(AT_HWCAP);   /* exercise AT_HWCAP read */\n  unsigned long ps=getauxval(AT_PAGESZ);\n  (void)hw;\n  printf(\"AUXV=%lu\\n\", ps); return 0;\n}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"AUXV=4096"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/awk-compute","image":"alpine:latest","step":{"exec":"awk 'BEGIN{for(i=1;i<=1000;i++)s+=i;print \"AWK=\"s}'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"AWK=500500"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/beam-jit","image":"erlang:27","step":{"exec":"erl -noshell -eval 'io:format(\"ERL=~w~n\",[lists:sum(lists:seq(1,1000))]), halt().'"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"ERL=500500"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/bpf-map-create","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <errno.h>\n#include <string.h>\n#include <sys/syscall.h>\n#include <linux/bpf.h>\n#include <unistd.h>\nint main(){\n  union bpf_attr a; memset(&a,0,sizeof a);\n  a.map_type=BPF_MAP_TYPE_ARRAY; a.key_size=4; a.value_size=4; a.max_entries=1;\n  long r=syscall(SYS_bpf,BPF_MAP_CREATE,&a,sizeof a);\n  printf(\"BPF=%s\\n\", r<0?strerror(errno):\"ok\"); return 0;\n}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"BPF=Operation not permitted"}],"xfail":[],"timeout":120,"terminal":false}
