{"id":"weird/eventfd","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <sys/eventfd.h>\n#include <unistd.h>\n#include <stdint.h>\nint main(){\n  int fd=eventfd(0,0);\n  uint64_t v=41; write(fd,&v,8); v=1; write(fd,&v,8);\n  uint64_t r; read(fd,&r,8);\n  printf(\"EVENTFD=%llu\\n\",(unsigned long long)r); return 0;\n}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"EVENTFD=42"}],"xfail":[],"timeout":120,"terminal":false}
