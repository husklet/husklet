{"id":"buildcmd/full","image":"alpine:latest","step":{"host":"export DOCKER_BUILDKIT=0\nprintf \"FROM alpine:latest\\nENV GREETING=BUILT_HELLO\\nRUN echo layerdata > /layerfile\\nCOPY payload.txt /payload.txt\\nWORKDIR /app\\nCMD sh -c \\\"echo \\$GREETING; cat /layerfile; cat /payload.txt; pwd\\\"\\n\" > \"$WORK/Dockerfile\"\necho COPIEDPAYLOAD > \"$WORK/payload.txt\"\ndocker build $PLAT -t ${C}img:build \"$WORK\" >/dev/null 2>&1\ndocker run --rm $PLAT ${C}img:build\ndocker rmi -f ${C}img:build >/dev/null 2>&1"},"targets":["arm64"],"class":"quick","checks":[{"contains":"BUILT_HELLO"},{"contains":"layerdata"},{"contains":"COPIEDPAYLOAD"},{"contains":"/app"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"buildcmd/simple","image":"alpine:latest","step":{"host":"export DOCKER_BUILDKIT=0\nprintf \"FROM alpine:latest\\nCMD echo SIMPLEBUILT\\n\" > \"$WORK/Dockerfile\"\ndocker build $PLAT -t ${C}img:s \"$WORK\" >/dev/null 2>&1\ndocker run --rm $PLAT ${C}img:s\ndocker rmi -f ${C}img:s >/dev/null 2>&1"},"targets":["arm64"],"class":"quick","checks":[{"contains":"SIMPLEBUILT"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"cpcmd/container-to-host-dir","image":"alpine:latest","step":{"host":"docker run -d --name ${C}c $PLAT $IMG sh -c \"mkdir -p /tmp/e; echo XXX>/tmp/e/x; echo YYY>/tmp/e/y; sleep 60\" >/dev/null; sleep 0.5\ndocker cp ${C}c:/tmp/e \"$WORK/e\"\ncat \"$WORK/e/x\"; cat \"$WORK/e/y\""},"targets":["arm64"],"class":"quick","checks":[{"contains":"XXX"},{"contains":"YYY"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"cpcmd/container-to-host-file","image":"alpine:latest","step":{"host":"docker run -d --name ${C}c $PLAT $IMG sh -c \"echo FROMCTR > /tmp/g; sleep 60\" >/dev/null; sleep 0.5\ndocker cp ${C}c:/tmp/g \"$WORK/g\"\ncat \"$WORK/g\""},"targets":["arm64"],"class":"quick","checks":[{"contains":"FROMCTR"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"cpcmd/host-to-container-dir","image":"alpine:latest","step":{"host":"mkdir -p \"$WORK/d\"; echo AAA > \"$WORK/d/a\"; echo BBB > \"$WORK/d/b\"\ndocker run -d --name ${C}c $PLAT $IMG sleep 60 >/dev/null; sleep 0.3\ndocker cp \"$WORK/d\" ${C}c:/tmp/d\ndocker exec ${C}c sh -c \"cat /tmp/d/a; cat /tmp/d/b\""},"targets":["arm64"],"class":"quick","checks":[{"contains":"AAA"},{"contains":"BBB"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"cpcmd/host-to-container-file","image":"alpine:latest","step":{"host":"echo CPFILE > \"$WORK/f\"\ndocker run -d --name ${C}c $PLAT $IMG sleep 60 >/dev/null; sleep 0.3\ndocker cp \"$WORK/f\" ${C}c:/tmp/f\ndocker exec ${C}c cat /tmp/f"},"targets":["arm64"],"class":"quick","checks":[{"contains":"CPFILE"}],"xfail":[],"timeout":30,"terminal":false}
