{"id":"weird/sched-affinity","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <sched.h>\nint main(){\n  cpu_set_t s; CPU_ZERO(&s);\n  if(sched_getaffinity(0,sizeof s,&s)<0){perror(\"aff\");return 1;}\n  printf(\"AFFINITY=%s\\n\", CPU_COUNT(&s)>0?\"nonzero\":\"zero\"); return 0;\n}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"AFFINITY=nonzero"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/seccomp-filter","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <linux/seccomp.h>\n#include <linux/filter.h>\n#include <sys/prctl.h>\n#include <sys/syscall.h>\n#include <unistd.h>\nint main(){\n  struct sock_filter f[]={ BPF_STMT(BPF_RET|BPF_K, SECCOMP_RET_ALLOW) };\n  struct sock_fprog prog={.len=1,.filter=f};\n  prctl(PR_SET_NO_NEW_PRIVS,1,0,0,0);\n  if(syscall(SYS_seccomp,SECCOMP_SET_MODE_FILTER,0,&prog)<0){perror(\"seccomp\");return 1;}\n  printf(\"SECCOMP=installed\\n\"); return 0;\n}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"SECCOMP=installed"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/self-modifying-rwx","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <string.h>\n#include <sys/mman.h>\nint main(void){\n  unsigned char *m=mmap(0,4096,PROT_READ|PROT_WRITE|PROT_EXEC,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);\n  if(m==MAP_FAILED){perror(\"mmap\");return 1;}\n#if defined(__x86_64__)\n  unsigned char code[]={0xB8,0x2A,0x00,0x00,0x00,0xC3};\n#elif defined(__aarch64__)\n  unsigned char code[]={0x40,0x05,0x80,0x52,0xC0,0x03,0x5F,0xD6};\n#endif\n  memcpy(m,code,sizeof(code));\n  __builtin___clear_cache((char*)m,(char*)m+sizeof(code));\n  int (*f)(void)=(int(*)(void))m;\n  printf(\"RWX=%d\\n\",f());\n  return 0;\n}\nCEOF\ncc /m.c -O0 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"RWX=42"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/sigsegv-recover","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <signal.h>\n#include <setjmp.h>\nstatic sigjmp_buf jb;\nstatic void h(int s){ (void)s; siglongjmp(jb,1); }\nint main(){\n  signal(SIGSEGV,h);\n  if(sigsetjmp(jb,1)==0){ volatile int *p=0; *p=1; printf(\"NOFAULT\\n\"); }\n  else printf(\"RECOVERED\\n\");\n  return 0;\n}\nCEOF\ncc /m.c -O0 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"RECOVERED"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/simd-probe","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#if defined(__x86_64__)\n#include <cpuid.h>\nint main(){ unsigned a,b,c,d; __get_cpuid(1,&a,&b,&c,&d);\n  printf(\"SIMD=%s\\n\",(d&(1u<<26))?\"ok\":\"no\"); return 0; }\n#elif defined(__aarch64__)\n#include <sys/auxv.h>\nint main(){ unsigned long h=getauxval(AT_HWCAP);\n  printf(\"SIMD=%s\\n\",(h&(1u<<1))?\"ok\":\"no\"); return 0; }\n#endif\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"SIMD=ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/smc-rewrite","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <string.h>\n#include <sys/mman.h>\ntypedef int(*fn)(void);\nint main(void){\n  unsigned char *m=mmap(0,4096,PROT_READ|PROT_WRITE|PROT_EXEC,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);\n  if(m==MAP_FAILED){perror(\"mmap\");return 1;}\n#if defined(__x86_64__)\n  unsigned char c1[]={0xB8,0x01,0x00,0x00,0x00,0xC3};\n  unsigned char c2[]={0xB8,0x02,0x00,0x00,0x00,0xC3};\n#elif defined(__aarch64__)\n  unsigned char c1[]={0x20,0x00,0x80,0x52,0xC0,0x03,0x5F,0xD6};\n  unsigned char c2[]={0x40,0x00,0x80,0x52,0xC0,0x03,0x5F,0xD6};\n#endif\n  memcpy(m,c1,sizeof c1); __builtin___clear_cache((char*)m,(char*)m+16);\n  int r1=((fn)m)();\n  memcpy(m,c2,sizeof c2); __builtin___clear_cache((char*)m,(char*)m+16);\n  int r2=((fn)m)();\n  printf(\"SMC=%d,%d\\n\",r1,r2); return 0;\n}\nCEOF\ncc /m.c -O0 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"SMC=1,2"}],"xfail":[],"timeout":120,"terminal":false}
