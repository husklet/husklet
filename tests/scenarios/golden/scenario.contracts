{"id":"databases/mongo-agg-7","image":"mongo:7","step":{"exec":"mongosh 'mongodb://%2Ftmp%2Fmongodb-27017.sock' --quiet --eval 'for(let i=1;i<=1000;i++) db.t.insertOne({n:i}); print(db.t.aggregate([{$group:{_id:null,s:{$sum:\"$n\"}}}]).toArray()[0].s)'"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"500500"}],"xfail":[],"timeout":240,"terminal":false,"service":{"startup":"mongod --bind_ip 127.0.0.1 --fork --logpath /tmp/mongo.log","probe":"mongosh 'mongodb://%2Ftmp%2Fmongodb-27017.sock' --quiet --eval 'db.runCommand({ping:1}).ok'","attempts":3,"delay_ms":1000,"logs":["/tmp/mongo.log"]}}
{"id":"databases/mongo-count-7","image":"mongo:7","step":{"exec":"mongosh 'mongodb://%2Ftmp%2Fmongodb-27017.sock' --quiet --eval 'for(let i=1;i<=1000;i++) db.t.insertOne({n:i}); print(db.t.countDocuments({}))'"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"1000"}],"xfail":[],"timeout":240,"terminal":false,"service":{"startup":"mongod --bind_ip 127.0.0.1 --fork --logpath /tmp/mongo.log","probe":"mongosh 'mongodb://%2Ftmp%2Fmongodb-27017.sock' --quiet --eval 'db.runCommand({ping:1}).ok'","attempts":3,"delay_ms":1000,"logs":["/tmp/mongo.log"]}}
{"id":"databases/mongo-filter-count-7","image":"mongo:7","step":{"exec":"mongosh 'mongodb://%2Ftmp%2Fmongodb-27017.sock' --quiet --eval 'for(let i=1;i<=1000;i++) db.t.insertOne({n:i}); print(db.t.countDocuments({n:{$lte:500}}))'"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"500"}],"xfail":[],"timeout":240,"terminal":false,"service":{"startup":"mongod --bind_ip 127.0.0.1 --fork --logpath /tmp/mongo.log","probe":"mongosh 'mongodb://%2Ftmp%2Fmongodb-27017.sock' --quiet --eval 'db.runCommand({ping:1}).ok'","attempts":3,"delay_ms":1000,"logs":["/tmp/mongo.log"]}}
{"id":"databases/mongo-parallel-readiness-7","image":"mongo:7","step":{"exec":"rm -f /tmp/mongo-ping.* /tmp/mongo-ready\nfor client in 1 2 3; do\n  (\n    mongosh 'mongodb://%2Ftmp%2Fmongodb-27017.sock' --quiet \\\n      --eval 'print(db.runCommand({ping:1}).ok)' \\\n      >\"/tmp/mongo-ping.$client\" 2>&1 &&\n    echo ready >> /tmp/mongo-ready\n  ) &\ndone\nwait\ntest \"$(wc -l < /tmp/mongo-ready)\" -eq 3\ngrep -Fx 1 /tmp/mongo-ping.1\ngrep -Fx 1 /tmp/mongo-ping.2\ngrep -Fx 1 /tmp/mongo-ping.3\necho MONGO_PARALLEL_READY"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"MONGO_PARALLEL_READY"}],"xfail":[],"timeout":240,"terminal":false,"service":{"startup":"mongod --bind_ip 127.0.0.1 --fork --logpath /tmp/mongo.log","probe":"test -S /tmp/mongodb-27017.sock","attempts":1,"delay_ms":0,"logs":["/tmp/mongo.log"]}}
{"id":"databases/mongo-version-8","image":"mongo:8","step":{"exec":"mongosh 'mongodb://%2Ftmp%2Fmongodb-27017.sock' --quiet --eval 'print(db.version())'"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"8."}],"xfail":[],"timeout":240,"terminal":false,"service":{"startup":"mongod --bind_ip 127.0.0.1 --fork --logpath /tmp/mongo.log","probe":"mongosh 'mongodb://%2Ftmp%2Fmongodb-27017.sock' --quiet --eval 'db.runCommand({ping:1}).ok'","attempts":3,"delay_ms":1000,"logs":["/tmp/mongo.log"]}}
{"id":"databases/mysql-agg-80","image":"mysql:8.0","step":{"exec":"export MYSQL_ROOT_PASSWORD=pw\n/usr/bin/env bash -c true\nprobe=$?\nif [ $probe -ne 0 ]; then echo mysql-bash-probe=$probe; exit $probe; fi\ndocker-entrypoint.sh mysqld >/tmp/my.log 2>&1 & server=$!\nfor i in $(seq 1 150); do if ! kill -0 $server 2>/dev/null; then wait $server; status=$?; echo mysql-entrypoint-exited=$status; cat /tmp/my.log; exit $status; fi; grep -q 'port: 3306' /tmp/my.log 2>/dev/null && break; sleep 1; done\nfor i in $(seq 1 30); do mysql -uroot -ppw -N -e 'SELECT 1' >/dev/null 2>&1 && break; sleep 1; done\nmysql -uroot -ppw -N -e \"CREATE DATABASE d; USE d; CREATE TABLE t(n INT); INSERT INTO t (n) WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM s WHERE x<1000) SELECT x FROM s; SELECT SUM(n) FROM t;\" || { status=$?; cat /tmp/my.log; ps -o pid,ppid,stat,comm,args; exit $status; }"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"500500"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"databases/mysql-agg-84","image":"mysql:8.4","step":{"exec":"export MYSQL_ROOT_PASSWORD=pw\n/usr/bin/env bash -c true\nprobe=$?\nif [ $probe -ne 0 ]; then echo mysql-bash-probe=$probe; exit $probe; fi\ndocker-entrypoint.sh mysqld >/tmp/my.log 2>&1 & server=$!\nfor i in $(seq 1 150); do if ! kill -0 $server 2>/dev/null; then wait $server; status=$?; echo mysql-entrypoint-exited=$status; cat /tmp/my.log; exit $status; fi; grep -q 'port: 3306' /tmp/my.log 2>/dev/null && break; sleep 1; done\nfor i in $(seq 1 30); do mysql -uroot -ppw -N -e 'SELECT 1' >/dev/null 2>&1 && break; sleep 1; done\nmysql -uroot -ppw -N -e \"CREATE DATABASE d; USE d; CREATE TABLE t(n INT); INSERT INTO t (n) WITH RECURSIVE s(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM s WHERE x<1000) SELECT x FROM s; SELECT SUM(n) FROM t;\" || { status=$?; cat /tmp/my.log; ps -o pid,ppid,stat,comm,args; exit $status; }"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"500500"}],"xfail":[],"timeout":120,"terminal":false}
