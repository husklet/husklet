{"id":"netinstall/debian-apt-update-clean","image":"debian:bookworm-slim","step":{"exec":"rm -rf /var/lib/apt/lists/*\napt-get update > /tmp/aptu.log 2>&1\nstatus=$?\ncat /tmp/aptu.log\nif [ \"$status\" -ne 0 ] \\\n    || grep -Eq '^(Ign|Err|W|E):|NO_PUBKEY|BADSIG|EXPKEYSIG' /tmp/aptu.log; then\n    echo APT_UPDATE_DIRTY\nelif find /var/lib/apt/lists -type f -name '*InRelease' -print -quit | grep -q . \\\n    && find /var/lib/apt/lists -type f -name '*_Packages*' -print -quit | grep -q .; then\n    echo APT_UPDATE_CLEAN\nelse\n    echo APT_UPDATE_NOLISTS\nfi"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"APT_UPDATE_CLEAN"}],"xfail":[],"timeout":180,"terminal":false}
{"id":"netinstall/ubuntu-apt-install-htop","image":"ubuntu:22.04","step":{"exec":"set -eu\nexport DEBIAN_FRONTEND=noninteractive\nrm -rf /var/lib/apt/lists/*\nif ! apt-get update >/tmp/apt-update.log 2>&1; then\n    cat /tmp/apt-update.log\n    exit 1\nfi\ninrelease=$(find /var/lib/apt/lists -type f -name '*InRelease' -print -quit)\ntest -n \"$inrelease\"\ngpgv --keyring /usr/share/keyrings/ubuntu-archive-keyring.gpg \"$inrelease\" \\\n    >/tmp/apt-signature.log 2>&1\napt-get install -y --no-install-recommends htop >/tmp/apt-install.log 2>&1\ncommand -v htop >/dev/null\ndpkg -s htop | grep -q '^Status: install ok installed'\napt-cache policy htop | grep -q 'Installed: [0-9]'\nhtop --version | grep -Eq '^htop [0-9]'\nif command -v ldd >/dev/null; then\n    ! ldd \"$(command -v htop)\" | grep -q 'not found'\nfi\necho HTOP_INSTALLED_AND_RUNNABLE"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"HTOP_INSTALLED_AND_RUNNABLE"}],"xfail":[],"timeout":240,"terminal":false}
{"id":"netinstall/ubuntu-apt-update-clean","image":"ubuntu:22.04","step":{"exec":"rm -rf /var/lib/apt/lists/*\napt-get update > /tmp/aptu.log 2>&1\nstatus=$?\ncat /tmp/aptu.log\nif [ \"$status\" -ne 0 ] \\\n    || grep -Eq '^(Ign|Err|W|E):|NO_PUBKEY|BADSIG|EXPKEYSIG' /tmp/aptu.log; then\n    echo APT_UPDATE_DIRTY\nelif find /var/lib/apt/lists -type f -name '*InRelease' -print -quit | grep -q . \\\n    && find /var/lib/apt/lists -type f -name '*_Packages*' -print -quit | grep -q .; then\n    echo APT_UPDATE_CLEAN\nelse\n    echo APT_UPDATE_NOLISTS\nfi"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"APT_UPDATE_CLEAN"}],"xfail":[],"timeout":180,"terminal":false}
{"id":"netinstall/ubuntu-htop-render","image":"ubuntu:22.04","step":{"exec":"export DEBIAN_FRONTEND=noninteractive TERM=xterm LINES=45 COLUMNS=200\napt-get update >/dev/null 2>&1\napt-get install -y htop >/dev/null 2>&1\n# a couple of uniquely-named processes so a REAL process row is guaranteed in the table.\nsleep 4242 & sleep 4243 &\necho q | htop -d 10 > /tmp/htop.frame 2>&1\nrc=$?\nf=$(tr -cd '[:print:]\\n' < /tmp/htop.frame)   # drop control bytes, keep the on-screen glyphs\necho \"$f\" | grep -q 'Tasks' \\\n  && echo \"$f\" | grep -q 'Load average' \\\n  && echo \"$f\" | grep -q 'PID' && echo \"$f\" | grep -q 'USER' && echo \"$f\" | grep -q 'Command' \\\n  && echo \"$f\" | grep -q 'Help' && echo \"$f\" | grep -q 'Quit' \\\n  && echo \"$f\" | grep -q 'sleep 4242' \\\n  && [ $rc -eq 0 ] && echo HTOP_RENDER_OK"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"HTOP_RENDER_OK"}],"xfail":[],"timeout":240,"terminal":false}
{"id":"netinstall/ubuntu-python-cryptography","image":"ubuntu:22.04","step":{"exec":"set -eu\nexport DEBIAN_FRONTEND=noninteractive\nrm -rf /var/lib/apt/lists/*\nif ! apt-get update >/tmp/apt-update.log 2>&1; then\n    cat /tmp/apt-update.log\n    exit 1\nfi\nif ! apt-get install -y --no-install-recommends python3-cryptography openssl ca-certificates \\\n    >/tmp/apt-install.log 2>&1; then\n    cat /tmp/apt-install.log\n    for attribute in mode timestamps ownership; do\n        rm -f /etc/inputrc\n        if cp \"--preserve=$attribute\" /usr/share/readline/inputrc /etc/inputrc; then\n            echo \"CP_PRESERVE_${attribute}_OK\"\n        else\n            echo \"CP_PRESERVE_${attribute}_FAILED\"\n        fi\n    done\n    exit 1\nfi\npython3 - <<'PY'\nfrom cryptography.hazmat.primitives.ciphers.aead import AESGCM\n\nkey = bytes(range(32))\nnonce = bytes(range(12))\nplain = b\"husklet-apt-cryptography\"\ncipher = AESGCM(key)\nsealed = cipher.encrypt(nonce, plain, b\"scenario\")\nassert cipher.decrypt(nonce, sealed, b\"scenario\") == plain\nprint(\"PYTHON_CRYPTOGRAPHY_OK\")\nPY\nprintf husklet | openssl dgst -sha256 | grep -Eq '[0-9a-f]{64}$'\necho OPENSSL_CRYPTOGRAPHY_OK"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"PYTHON_CRYPTOGRAPHY_OK"},{"contains":"OPENSSL_CRYPTOGRAPHY_OK"}],"xfail":[],"timeout":240,"terminal":false}
{"id":"netinstall/ubuntu-top-render","image":"ubuntu:22.04","step":{"exec":"export DEBIAN_FRONTEND=noninteractive\napt-get update >/dev/null 2>&1\napt-get install -y procps >/dev/null 2>&1\nsleep 5252 &\ntop -bn1 > /tmp/top.out 2>&1\nrc=$?\ngrep -q 'Tasks:' /tmp/top.out \\\n  && grep -Eq '%Cpu' /tmp/top.out \\\n  && grep -q 'PID USER' /tmp/top.out \\\n  && grep -q 'sleep' /tmp/top.out \\\n  && [ $rc -eq 0 ] && echo TOP_RENDER_OK"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"TOP_RENDER_OK"}],"xfail":[],"timeout":240,"terminal":false}
{"id":"networking/getent-localhost","image":"debian:bookworm","step":{"exec":"getent hosts localhost"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"localhost"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"networking/loopback-iface","image":"alpine:latest","step":{"exec":"ip addr show lo 2>/dev/null | grep -q '127.0.0.1' && echo LO_UP || { ifconfig lo 2>/dev/null | grep -q '127.0.0.1' && echo LO_UP; }"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"LO_UP"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"networking/outbound-dns","image":"alpine:latest","step":{"exec":"cat /etc/resolv.conf\nnslookup one.one.one.one 2>&1 | tee /tmp/nslookup.out\ngrep -qiE '1\\.1\\.1\\.1|1\\.0\\.0\\.1' /tmp/nslookup.out && echo DNS_OUT_OK"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"DNS_OUT_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"networking/outbound-tcp","image":"busybox:latest","step":{"exec":"nc -z -v -w 3 1.1.1.1 53\nstatus=$?\nif [ \"$status\" -eq 0 ]; then\n  echo OUT_TCP_OK\nelse\n  echo \"OUT_TCP_FAIL status=$status\"\n  ip route\n  exit \"$status\"\nfi"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"OUT_TCP_OK"}],"xfail":[],"timeout":30,"terminal":false}
{"id":"networking/redis-loopback-incr","image":"redis:alpine","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 40); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.1; done\nfor i in $(seq 1 1000); do redis-cli incr c >/dev/null; done\nredis-cli get c"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"1000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"networking/redis-loopback-setget","image":"redis:alpine","step":{"exec":"redis-server --save '' --appendonly no --daemonize yes >/dev/null 2>&1\nfor i in $(seq 1 40); do redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.1; done\nredis-cli set k loopval >/dev/null\nredis-cli get k"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"loopval"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"networking/tcp-loopback","image":"busybox:latest","step":{"exec":"( echo TCPOK | nc -l -p 9100 ) & sleep 0.4\nnc -w 2 127.0.0.1 9100"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"TCPOK"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"networking/two-ports","image":"busybox:latest","step":{"exec":"( echo AAA | nc -l -p 9110 ) & ( echo BBB | nc -l -p 9111 ) & sleep 0.4\necho \"$(nc -w 2 127.0.0.1 9110)-$(nc -w 2 127.0.0.1 9111)\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"AAA-BBB"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"networking/udp-loopback","image":"busybox:latest","step":{"exec":"( echo UDPOK | nc -u -l -s 127.0.0.1 -p 9101 -w 1 ) & sleep 0.4\necho ping | nc -u -w 1 127.0.0.1 9101"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"UDPOK"}],"xfail":[],"timeout":120,"terminal":false}
