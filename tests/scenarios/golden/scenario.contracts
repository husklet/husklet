{"id":"utilities/compile-c-qsort","image":"gcc:13","step":{"exec":"gcc -O2 -x c -o /tmp/p - <<'EOF' && /tmp/p\n#include <stdio.h>\n#include <stdlib.h>\nstatic int cmp(const void*a,const void*b){long x=*(const long*)a,y=*(const long*)b;return (x>y)-(x<y);}\nint main(void){static long v[100000];for(int i=0;i<100000;i++)v[i]=99999-i;qsort(v,100000,sizeof(long),cmp);long s=0;for(int i=0;i<100000;i++)s+=v[i];printf(\"QS %ld %ld %ld\\n\",v[0],v[99999],s);return 0;}\nEOF"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"QS 0 99999 4999950000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/compile-c-sieve","image":"gcc:13","step":{"exec":"gcc -O2 -x c -o /tmp/p - <<'EOF' && /tmp/p\n#include <stdio.h>\nint main(void){static char c[1000000];int n=0;for(long i=2;i<1000000;i++){if(!c[i]){n++;for(long j=i*i;j<1000000;j+=i)c[j]=1;}}printf(\"PRIMES %d\\n\",n);return 0;}\nEOF"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"PRIMES 78498"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/compile-cpp-map","image":"gcc:13","step":{"exec":"g++ -O2 -x c++ -o /tmp/p - <<'EOF' && /tmp/p\n#include <cstdio>\n#include <map>\n#include <string>\nint main(){std::map<std::string,int> m;const char* w[]={\"a\",\"b\",\"a\",\"c\",\"b\",\"a\"};for(auto s:w)m[s]++;printf(\"MAP %d %d %d %zu\\n\",m[\"a\"],m[\"b\"],m[\"c\"],m.size());return 0;}\nEOF"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"MAP 3 2 1 3"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/compile-cpp-stl","image":"gcc:13","step":{"exec":"g++ -O2 -x c++ -o /tmp/p - <<'EOF' && /tmp/p\n#include <cstdio>\n#include <vector>\n#include <numeric>\n#include <algorithm>\nint main(){std::vector<long> v;for(long i=1;i<=1000000;i++)v.push_back(i);std::sort(v.begin(),v.end(),std::greater<long>());long s=std::accumulate(v.begin(),v.end(),0L);printf(\"SUM %ld %ld\\n\",s,v.front());return 0;}\nEOF"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"SUM 500000500000 1000000"}],"xfail":[],"timeout":120,"terminal":false}
