{"id":"databases/memcached-roundtrip","image":"memcached:1.6-alpine","step":{"exec":"memcached -d -u root -l 127.0.0.1 -p 11211\nsleep 1\n( printf 'set dd 0 0 5\\r\\nhello\\r\\nget dd\\r\\nquit\\r\\n'; sleep 0.3 ) | nc 127.0.0.1 11211"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"VALUE dd 0 5"},{"contains":"hello"}],"xfail":[],"timeout":60,"terminal":false}
