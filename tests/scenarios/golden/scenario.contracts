{"id":"utilities/nodecompute-gc-churn","image":"node:22-alpine","step":{"exec":"node -e 'let s=0;for(let k=0;k<100;k++){let a=[];for(let i=0;i<1000;i++)a.push(i);s+=a.reduce((x,y)=>x+y,0)}console.log(\"GC\",s)'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"GC 49950000"}],"xfail":[],"timeout":120,"terminal":false}
