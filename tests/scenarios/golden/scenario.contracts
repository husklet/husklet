{"id":"weird/pthread-atomics","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <pthread.h>\n#include <stdatomic.h>\natomic_long c=0;\nvoid*w(void*x){ (void)x; for(int i=0;i<100000;i++) atomic_fetch_add(&c,1); return 0; }\nint main(){ pthread_t t[8]; for(int i=0;i<8;i++)pthread_create(&t[i],0,w,0);\n  for(int i=0;i<8;i++)pthread_join(t[i],0);\n  printf(\"THREADS=%ld\\n\",(long)c); return 0;}\nCEOF\ncc /m.c -O2 -pthread -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"THREADS=800000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/ptrace-traceme","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <sys/ptrace.h>\nint main(){\n  long r=ptrace(PTRACE_TRACEME,0,0,0);\n  printf(\"PTRACE=%ld\\n\", r); return 0;\n}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"PTRACE=0"}],"xfail":[],"timeout":120,"terminal":false}
