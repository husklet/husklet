{"id":"utilities/perlcompute-hash","image":"perl:5.40","step":{"exec":"perl -e 'my %h; for my $i (0..99999){ $h{$i%1000}+=$i } my $s=0; $s+=$_ for values %h; print \"HS $s \",scalar(keys %h),\"\\n\"'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"HS 4999950000 1000"}],"xfail":[],"timeout":120,"terminal":false}
