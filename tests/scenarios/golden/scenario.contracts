{"id":"databases/couchdb-create-db","image":"couchdb:3","step":{"exec":"export COUCHDB_USER=admin COUCHDB_PASSWORD=pw\n/docker-entrypoint.sh /opt/couchdb/bin/couchdb >/tmp/couch.log 2>&1 &\nready=false\nfor i in $(seq 1 150); do\n  if curl --max-time 2 -fsS http://admin:pw@127.0.0.1:5984/ | grep -q Welcome; then\n    ready=true\n    break\n  fi\n  sleep 1\ndone\nif [ \"$ready\" != true ]; then\n  cat /tmp/couch.log >&2\n  exit 1\nfi\ncurl --max-time 5 -fsS -X PUT http://admin:pw@127.0.0.1:5984/hlb\n"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"\"ok\":true"}],"xfail":[],"timeout":240,"terminal":false}
{"id":"databases/couchdb-welcome","image":"couchdb:3","step":{"exec":"export COUCHDB_USER=admin COUCHDB_PASSWORD=pw\n/docker-entrypoint.sh /opt/couchdb/bin/couchdb >/tmp/couch.log 2>&1 &\nready=false\nfor i in $(seq 1 150); do\n  if curl --max-time 2 -fsS http://admin:pw@127.0.0.1:5984/ | grep -q Welcome; then\n    ready=true\n    break\n  fi\n  sleep 1\ndone\nif [ \"$ready\" != true ]; then\n  cat /tmp/couch.log >&2\n  exit 1\nfi\ncurl --max-time 5 -fsS http://admin:pw@127.0.0.1:5984/\n"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"\"couchdb\":\"Welcome\""}],"xfail":[],"timeout":240,"terminal":false}
