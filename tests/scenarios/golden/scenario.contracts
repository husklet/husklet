{"id":"utilities/proc-stat-cpu","image":"alpine:3.24.1","step":{"exec":"grep -q '^cpu ' /proc/stat && echo stat-ok"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"stat-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/proc-status-gid","image":"alpine:3.24.1","step":{"exec":"awk '/^Gid:/{print $2}' /proc/self/status"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"0"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/proc-status-uid","image":"alpine:3.24.1","step":{"exec":"awk '/^Uid:/{print $2}' /proc/self/status"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"0"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/proc-uptime","image":"alpine:3.24.1","step":{"exec":"awk '{print ($1>=0)?\"up-ok\":\"bad\"}' /proc/uptime"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"up-ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/proc-version-linux","image":"alpine:3.24.1","step":{"exec":"head -c5 /proc/version"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"Linux"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-ackermann","image":"python:3.13-slim","step":{"exec":"python3 -c \"import sys\nsys.setrecursionlimit(100000)\ndef a(m,n):\n return n+1 if m==0 else (a(m-1,1) if n==0 else a(m-1,a(m,n-1)))\nprint('ACK', a(2,3))\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"ACK 9"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-bigint-pow","image":"python:3.13-slim","step":{"exec":"python3 -c \"print('BI', 2**100)\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"BI 1267650600228229401496703205376"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-dict-agg","image":"python:3.13-slim","step":{"exec":"python3 -c \"d={}\nfor i in range(100000): d[i%1000]=d.get(i%1000,0)+i\nprint('SUM', sum(d.values()), len(d))\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"SUM 4999950000 1000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-fib30","image":"python:3.13-slim","step":{"exec":"python3 -c \"import sys\nsys.setrecursionlimit(100000)\ndef f(n):\n return n if n<2 else f(n-1)+f(n-2)\nprint('FIB', f(30))\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"FIB 832040"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-gc-churn","image":"python:3.13-slim","step":{"exec":"python3 -c \"s=0\nfor _ in range(100): s+=sum([i*i for i in range(1000)])\nprint('GC', s)\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"GC 33283350000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-harmonic","image":"python:3.13-slim","step":{"exec":"python3 -c \"print('H %.6f' % sum(1.0/n for n in range(1,1000001)))\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"H 14.392727"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-json-roundtrip","image":"python:3.13-slim","step":{"exec":"python3 -c \"import json\no={'a':list(range(1000)),'b':{'x':'ддд'}}\ns=json.dumps(o,ensure_ascii=False)\np=json.loads(s)\nprint('JSON', sum(p['a']), p['b']['x'])\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"JSON 499500 ддд"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-regex","image":"python:3.13-slim","step":{"exec":"python3 -c \"import re\ns='ab'*100000\nprint('RE', len(re.findall('ab',s)), bool(re.match(r'(a+)+$','a'*20)))\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"RE 100000 True"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-setops","image":"python:3.13-slim","step":{"exec":"python3 -c \"A=set(range(100000))\nB=set(range(50000,150000))\nprint('SET', len(A&B), len(A|B))\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"SET 50000 150000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-sha256-1mb","image":"python:3.13-slim","step":{"exec":"python3 -c \"import hashlib\nprint(hashlib.sha256(b'\\0'*1048576).hexdigest())\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"30e14955ebf1352266dc2ff8067e68104607e750abb9d3b36582b8af909fcb58"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-sort-1e5","image":"python:3.13-slim","step":{"exec":"python3 -c \"a=list(range(100000))\na.sort(reverse=True)\nprint('S', a[0], a[-1], sum(a))\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"S 99999 0 4999950000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/pycompute-strbuilder","image":"python:3.13-slim","step":{"exec":"python3 -c \"print('SB', len(''.join(str(i) for i in range(100000))))\""},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"SB 488890"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/readlink-canon","image":"alpine:3.24.1","step":{"exec":"readlink -f /etc/../etc/passwd"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"/etc/passwd"}],"xfail":[],"timeout":120,"terminal":false}
