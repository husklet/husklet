{"id":"utilities/rubycompute-bignum","image":"ruby:3.3-alpine","step":{"exec":"ruby -e 'puts \"BN #{2**100}\"'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"BN 1267650600228229401496703205376"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/rubycompute-fib30","image":"ruby:3.3-alpine","step":{"exec":"ruby -e 'def f(n); n<2 ? n : f(n-1)+f(n-2); end; puts \"FIB #{f(30)}\"'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"FIB 832040"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"utilities/rubycompute-hash-agg","image":"ruby:3.3-alpine","step":{"exec":"ruby -e 'h=Hash.new(0);(0...100000).each{|i| h[i%1000]+=i}; puts \"HS #{h.values.sum} #{h.size}\"'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"HS 4999950000 1000"}],"xfail":[],"timeout":120,"terminal":false}
