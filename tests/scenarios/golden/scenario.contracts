{"id":"weird/tcl","image":"debian:bookworm","step":{"exec":"set -eu; apt-get update >/dev/null; apt-get install -y tcl >/dev/null; command -v tclsh >/dev/null; echo 'set s 0; for {set i 1} {$i<=1000} {incr i} {incr s $i}; puts TCL=$s' | tclsh"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"TCL=500500"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/timerfd","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <sys/timerfd.h>\n#include <unistd.h>\n#include <stdint.h>\nint main(){\n  int fd=timerfd_create(CLOCK_MONOTONIC,0);\n  if(fd<0){perror(\"timerfd\");return 1;}\n  struct itimerspec its={{0,0},{0,50000000}};\n  timerfd_settime(fd,0,&its,0);\n  uint64_t e; read(fd,&e,8);\n  printf(\"TIMERFD=%llu\\n\",(unsigned long long)e); return 0;\n}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"TIMERFD=1"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/tsc-counter","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <stdint.h>\nstatic inline uint64_t rd(){\n#if defined(__x86_64__)\n unsigned lo,hi; __asm__ volatile(\"rdtsc\":\"=a\"(lo),\"=d\"(hi)); return ((uint64_t)hi<<32)|lo;\n#elif defined(__aarch64__)\n uint64_t v; __asm__ volatile(\"mrs %0, cntvct_el0\":\"=r\"(v)); return v;\n#endif\n}\nint main(){uint64_t a=rd(); for(volatile long i=0;i<100000;i++); uint64_t b=rd();\n printf(\"TSC=%s\\n\", b>=a?\"ok\":\"no\"); return 0;}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"TSC=ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/userfaultfd","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#define _GNU_SOURCE\n#include <stdio.h>\n#include <linux/userfaultfd.h>\n#include <sys/syscall.h>\n#include <sys/ioctl.h>\n#include <unistd.h>\nint main(){\n  int fd=syscall(SYS_userfaultfd,0);\n  if(fd<0){perror(\"userfaultfd\");return 1;}\n  struct uffdio_api api={.api=UFFD_API};\n  if(ioctl(fd,UFFDIO_API,&api)<0){perror(\"api\");return 1;}\n  printf(\"UFFD=ok\\n\"); return 0;\n}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"userfaultfd: Operation not permitted"},{"exit":1}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/v8-bigint","image":"node:alpine","step":{"exec":"node -e 'let a=0n,b=1n;for(let i=0;i<90;i++){[a,b]=[b,a+b]};console.log(\"FIB=\"+a)'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"FIB=2880067194370816120"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/v8-jit-in-jit","image":"node:alpine","step":{"exec":"node -e 'let s=0;for(let i=1;i<=1000000;i++)s+=i;console.log(\"sum\",s)'"},"targets":["arm64","amd64"],"class":"quick","checks":[{"contains":"sum 500000500000"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/vdso-clock","image":"gcc:latest","step":{"exec":"cat > /m.c <<'CEOF'\n#include <stdio.h>\n#include <time.h>\nint main(){struct timespec a,b; clock_gettime(CLOCK_MONOTONIC,&a);\n  for(volatile long i=0;i<1000000;i++); clock_gettime(CLOCK_MONOTONIC,&b);\n  printf(\"CLOCK=%s\\n\",(b.tv_sec>a.tv_sec||(b.tv_sec==a.tv_sec&&b.tv_nsec>=a.tv_nsec))?\"ok\":\"no\"); return 0;}\nCEOF\ncc /m.c -O2 -o /m && /m"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"CLOCK=ok"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/xz-roundtrip","image":"debian:bookworm","step":{"exec":"set -eu; apt-get update >/dev/null; apt-get install -y xz-utils >/dev/null; seq 1 1000 > /tmp/input; xz -9 -c /tmp/input > /tmp/input.xz; xz -d -c /tmp/input.xz > /tmp/output; cmp /tmp/input /tmp/output; awk '{s+=$1}END{print \"XZ=\"s}' /tmp/output"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"XZ=500500"}],"xfail":[],"timeout":120,"terminal":false}
{"id":"weird/zstd-roundtrip","image":"debian:bookworm","step":{"exec":"set -eu; apt-get update >/dev/null; apt-get install -y zstd >/dev/null; seq 1 1000 > /tmp/input; zstd -q -19 -o /tmp/input.zst /tmp/input; zstd -q -d -o /tmp/output /tmp/input.zst; cmp /tmp/input /tmp/output; awk '{s+=$1}END{print \"ZSTD=\"s}' /tmp/output"},"targets":["arm64","amd64"],"class":"long","checks":[{"contains":"ZSTD=500500"}],"xfail":[],"timeout":120,"terminal":false}
