# ---- signals ----
# NOTE: rt_sigaction/rt_sigprocmask/sigaltstack have only LEGACY-API tests in
# LTP; those don't build against glibc-2.34+/gcc-15 (non-constant SIGSTKSZ,
# tst_sig() prototype tightening) — see docs "Skipped". Signal-delivery
# coverage is provided instead by the new-API tests below, which exercise the
# same rt_sig* kernel surface (mask/queue/wait/suspend/deliver).
signal  signal          signal/signal01.c
signal  signal          signal/signal02.c
signal  signal          signal/signal03.c
signal  signal          signal/signal04.c
signal  signal          signal/signal05.c
signal  sigsuspend      sigsuspend/sigsuspend01.c
signal  sigsuspend      sigsuspend/sigsuspend02.c
signal  sigpending      sigpending/sigpending02.c
signal  rt_sigqueueinfo rt_sigqueueinfo/rt_sigqueueinfo01.c
signal  pause           pause/pause01.c
signal  pause           pause/pause02.c

