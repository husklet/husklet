{
  "name": "@husklet/repository",
  "private": true,
  "type": "module",
  "description": "Husklet JavaScript packages and first-party extensions.",
  "workspaces": [
    "packages/client",
    "packages/react",
    "extensions/storybook",
    "extensions/top"
  ],
  "scripts": {
    "build:extensions": "npm run build --workspace @husklet/top --workspace @husklet/storybook",
    "test:extensions": "npm test --workspace @husklet/top --workspace @husklet/storybook",
    "test:sdk": "npm test --workspace @husklet/client --workspace @husklet/react",
    "test": "npm run test:sdk && npm run test:extensions",
    "prepublish:check": "node tools/npm/prepublish-check.js",
    "postpublish:check": "node tools/npm/postpublish-check.js"
  },
  "engines": { "node": ">=20" }
}
