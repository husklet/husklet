  "lengths": [
    {"shape": "Step", "argument": "integer", "minimum": 0, "maximum": 12, "note": "steps on the 4px spacing scale; higher steps clamp"},
    {"shape": "Chars", "argument": "integer", "minimum": 0, "maximum": 65535, "note": "text-relative width in characters"},
    {"shape": "Fill", "argument": null, "note": "expand to fill the available space"},
    {"shape": "Content", "argument": null, "note": "natural size of the content"}
  ],
  "notes": {
    "propsPerTag": "The library holds no per-tag property list: an adapter applies every property to every tag and ignores what a widget cannot express. Every property is therefore offered for every component, and this catalogue does not claim which are meaningful.",
    "values": "A property's value shapes are the PropValue variants an adapter reads for it. Sending another shape is not an error; it is ignored.",
    "lengthEncoding": "A Length is an externally tagged enum: {\"Step\": 2}, {\"Chars\": 20}, \"Fill\", \"Content\"."
  }
}
