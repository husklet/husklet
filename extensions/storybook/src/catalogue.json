    {"name": "Help", "group": "content", "editor": "text", "values": ["Text"], "note": "explanation revealed by a pointer"},
    {"name": "Icon", "group": "content", "editor": "text", "values": ["Text"], "note": "named icon"},
    {"name": "Tooltip", "group": "content", "editor": "text", "values": ["Text"], "note": "explanation revealed by a pointer"},
    {"name": "Uri", "group": "content", "editor": "text", "values": ["Text"], "note": "the address a link points at, or the file a picture or a video plays"},
    {"name": "Enabled", "group": "state", "editor": "switch", "values": ["Flag"], "note": "defaults to enabled when absent"},
    {"name": "Visible", "group": "state", "editor": "switch", "values": ["Flag"], "note": "defaults to visible when absent"},
    {"name": "Selected", "group": "state", "editor": "switch", "values": ["Flag"], "note": "read like Checked"},
    {"name": "Checked", "group": "state", "editor": "switch", "values": ["Flag"], "note": "for a check button, a toggle button or a switch"},
    {"name": "Expanded", "group": "state", "editor": "switch", "values": ["Flag"], "note": "for an expander or a revealed panel"},
    {"name": "Busy", "group": "state", "editor": "switch", "values": ["Flag"], "note": "runs a spinner; defaults to busy when absent"},
    {"name": "Secret", "group": "state", "editor": "switch", "values": ["Flag"], "note": "hides typed text, and on a password entry withholds the peek icon"},
    {"name": "Monospace", "group": "state", "editor": "switch", "values": ["Flag"], "note": "for a text view; defaults to monospace when absent"},
    {"name": "Wrap", "group": "state", "editor": "switch", "values": ["Flag"], "note": "words onto further lines for text, whole children for a row or a column"},
    {"name": "Ellipsize", "group": "state", "editor": "switch", "values": ["Flag"], "note": "for a label"},
    {"name": "Variant", "group": "appearance", "editor": "enum", "values": ["Variant"], "note": "emphasis level"},
    {"name": "Tone", "group": "appearance", "editor": "enum", "values": ["Tone"], "note": "semantic weight"},
    {"name": "Scale", "group": "appearance", "editor": "enum", "values": ["Scale"], "note": "text size role"},
    {"name": "Color", "group": "appearance", "editor": "enum", "values": ["Token"], "note": "a semantic color slot, never a literal color"},
    {"name": "Gap", "group": "layout", "editor": "length", "values": ["Length"], "note": "space between children; only a Step length has a pixel size"},
    {"name": "Pad", "group": "layout", "editor": "edges", "values": ["Length", "Edges"], "note": "a Length applies to all four sides; Edges names them separately"},
    {"name": "Grow", "group": "layout", "editor": "number", "values": ["Number", "Integer"], "note": "any value above zero expands the child on both axes"},
    {"name": "Width", "group": "layout", "editor": "length", "values": ["Length", "Bounds"], "note": "an exact extent, or a floor and a ceiling"},
    {"name": "Height", "group": "layout", "editor": "length", "values": ["Length", "Bounds"], "note": "an exact extent, or a floor and a ceiling"},
    {"name": "Align", "group": "layout", "editor": "enum", "values": ["Align"], "note": "placement along the main axis"},
    {"name": "Justify", "group": "layout", "editor": "enum", "values": ["Align"], "note": "placement along the cross axis"},
    {"name": "Columns", "group": "layout", "editor": "number", "values": ["Integer", "Number"], "note": "grid column count, or a table's declared column count; never below one"},
    {"name": "Span", "group": "layout", "editor": "number", "values": ["Integer", "Number"], "note": "grid columns this child occupies; never below one"},
    {"name": "RowSpan", "group": "layout", "editor": "number", "values": ["Integer", "Number"], "note": "grid rows this child occupies; never below one"},
    {"name": "Orientation", "group": "layout", "editor": "enum", "values": ["Orientation"], "note": "axis of a container, a splitter or a divider"},
    {"name": "Position", "group": "layout", "editor": "number", "values": ["Number", "Integer"], "note": "the divider position of a splitter, in pixels"},
    {"name": "Minimum", "group": "range", "editor": "number", "values": ["Number", "Integer"], "note": "lower bound of a slider or a number entry"},
    {"name": "Maximum", "group": "range", "editor": "number", "values": ["Number", "Integer"], "note": "upper bound of a slider or a number entry"},
    {"name": "Step", "group": "range", "editor": "number", "values": ["Number", "Integer"], "note": "increment of a slider or a number entry"},
    {"name": "Fraction", "group": "range", "editor": "number", "values": ["Number", "Integer"], "note": "progress or meter fill, clamped to nought through one"},
    {"name": "Schema", "group": "collection", "editor": "schema", "values": ["Schema"], "note": "table columns: key, title, width as a Length, align, sortable"},
    {"name": "Source", "group": "collection", "editor": "source", "values": ["Source"], "note": "identity of the windowed row source backing a collection"},
    {"name": "RowHeight", "group": "collection", "editor": "number", "values": ["Number", "Integer"], "note": "row height of a windowed collection"},
    {"name": "Choices", "group": "collection", "editor": "choices", "values": ["Choices"], "note": "options of a select or a radio group, each a value and a label"}
  ],
