  "props": [
    {"name": "Label", "group": "content", "editor": "text", "values": ["Text"], "note": "the node's caption"},
    {"name": "Detail", "group": "content", "editor": "text", "values": ["Text"], "note": "secondary text beside the label, or a tooltip where there is no room"},
    {"name": "Value", "group": "content", "editor": "text", "values": ["Text", "Number", "Integer"], "note": "what a field holds or a display shows; numeric for a slider, a number entry and a rating"},
