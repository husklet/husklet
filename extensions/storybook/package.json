{
  "name": "@husklet/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "A component playground: browse the library, render it, edit its properties.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'examples/**/*.tsx' 'test/**/*.js' vite.config.ts",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'examples/**/*.tsx' 'test/**/*.js' vite.config.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'examples/**/*.tsx' vite.config.ts --max-warnings 0",
    "test": "npm run build && node --test 'test/*.test.js'",
    "catalogue": "cargo run -q --manifest-path ../../Cargo.toml -p hl-gui --bin catalogue > src/catalogue.json"
  },
  "dependencies": {
    "@husklet/react": "file:../base/react",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.3",
    "typescript": "5.9.2",
    "vite": "7.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
