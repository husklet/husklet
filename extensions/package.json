{
  "name": "@husklet/extensions",
  "private": true,
  "type": "module",
  "description": "Husklet JavaScript packages and first-party extensions.",
  "workspaces": [
    "base/client",
    "base/react",
    "storybook",
    "top"
  ],
  "scripts": {
    "build:sdk": "npm run build --workspace @husklet/client --workspace @husklet/react",
    "build:extensions": "npm run build --workspace @husklet/top --workspace @husklet/storybook",
    "format:extensions": "npm run format --workspace @husklet/top --workspace @husklet/storybook",
    "format:check:extensions": "npm run format:check --workspace @husklet/top --workspace @husklet/storybook",
    "lint:extensions": "npm run lint --workspace @husklet/top --workspace @husklet/storybook",
    "test:extensions": "npm run lint:extensions && npm run format:check:extensions && npm test --workspace @husklet/top --workspace @husklet/storybook",
    "lint:sdk": "npm run lint --workspace @husklet/client --workspace @husklet/react && eslint 'base/tools/npm/*.js' --max-warnings 0",
    "test:sdk": "npm run lint:sdk && npm run build:sdk && npm test --workspace @husklet/client --workspace @husklet/react",
    "test": "npm run test:sdk && npm run test:extensions",
    "prepublish:check": "node base/tools/npm/prepublish-check.js",
    "postpublish:check": "node base/tools/npm/postpublish-check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
