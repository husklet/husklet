{
  "name": "@husklet/top",
  "version": "0.1.0",
  "private": true,
  "description": "Compact first-party workspace control surface for Husklet.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'test/**/*.js' vite.config.ts",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'test/**/*.js' vite.config.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}' vite.config.ts --max-warnings 0",
    "test": "npm run build && node --test 'test/*.test.js'"
  },
  "dependencies": {
    "@husklet/react": "file:../base/react",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "18.3.3",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
