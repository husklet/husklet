{
  "name": "@husklet/client",
  "version": "0.1.0",
  "description": "Framework-neutral typed client for the Husklet extension socket",
  "repository": { "type": "git", "url": "git+https://github.com/husklet/husklet.git", "directory": "extensions/client" },
  "publishConfig": { "access": "public", "provenance": true },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": { ".": { "types": "./src/index.d.ts", "import": "./src/index.js", "default": "./src/index.js" }, "./protocol": { "types": "./src/generated-protocol.d.ts", "import": "./src/generated-protocol.js" }, "./wire": "./src/wire.js", "./package.json": "./package.json" },
  "files": ["src", "README.md", "LICENSE"],
  "scripts": { "test": "node tools/protocol-spec.js && node --test", "pack:check": "npm pack --dry-run", "protocol:generate": "node tools/protocol-spec.js --write" },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
