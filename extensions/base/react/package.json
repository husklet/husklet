{
  "name": "@husklet/react",
  "version": "0.1.0",
  "description": "Render a Husklet workspace interface with React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/husklet/husklet.git",
    "directory": "extensions/base/react"
  },
  "homepage": "https://github.com/husklet/husklet#readme",
  "bugs": "https://github.com/husklet/husklet/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./catalogue": "./catalogue.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "catalogue.json",
    "examples/starter",
    "examples/embeddings-workbench.ts",
    "examples/git-review-workbench.ts",
    "examples/postgres-inspector.ts",
    "examples/debugger-workbench.ts",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/types.js",
    "prepack": "npm run build",
    "test": "npm run build && npm run types:examples && node --test 'test/*.test.js' && node tools/package-smoke.js",
    "lint": "eslint --config eslint.config.js 'src/**/*.{ts,tsx}' 'tools/*.js' --max-warnings 0",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "types:examples": "tsc --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,DOM --esModuleInterop --skipLibCheck --noEmit examples/embeddings-workbench.ts examples/git-review-workbench.ts examples/postgres-inspector.ts examples/debugger-workbench.ts",
    "pack:check": "node tools/package-smoke.js",
    "catalogue": "cargo run -q --manifest-path ../../../Cargo.toml -p hl-gui --bin catalogue > catalogue.json",
    "types": "npm run catalogue && npm run build"
  },
  "dependencies": {
    "@husklet/client": "0.1.0",
    "@types/react": "18.3.31",
    "react-reconciler": "0.29.2"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react-reconciler": "^0.28.9",
    "react": "^18.3.1",
    "typescript": "^5.9.2"
  }
}
