{
  "name": "@husklet/client",
  "version": "0.1.0",
  "description": "Framework-neutral typed client for the Husklet extension socket",
  "repository": { "type": "git", "url": "git+https://github.com/husklet/husklet.git", "directory": "extensions/base/client" },
  "publishConfig": { "access": "public", "provenance": true },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": { ".": { "types": "./src/index.d.ts", "import": "./src/index.js", "default": "./src/index.js" }, "./protocol": { "types": "./src/generated-protocol.d.ts", "import": "./src/generated-protocol.js" }, "./wire": "./src/wire.js", "./package.json": "./package.json" },
  "files": ["src", "examples/starter", "examples/agent-control.mjs", "examples/agent-container-control.mjs", "examples/agent-workspace-control.mjs", "examples/llm-terminal-agent.ts", "examples/embeddings-indexer.ts", "README.md", "API.md", "LICENSE"],
  "scripts": { "test": "npm run types:examples && node tools/protocol-spec.js && node tools/api-reference.js && node --test test/*.test.js && node tools/package-smoke.js", "types:examples": "tsc --module NodeNext --moduleResolution NodeNext --target ES2022 --lib ES2022,DOM --skipLibCheck --noEmit examples/llm-terminal-agent.ts examples/embeddings-indexer.ts", "pack:check": "node tools/package-smoke.js", "protocol:generate": "node tools/protocol-spec.js --write", "api:generate": "node tools/api-reference.js --write" },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
