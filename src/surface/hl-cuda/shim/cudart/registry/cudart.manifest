# CUDA Runtime API entry-point manifest for dd-shim-cudart. Format: RT<TAB>name<TAB>ret<TAB>params
# (params = `ctype|pname` joined by `;`; empty for a `void` parameter list). Consumed by build.rs.
#
# Two sections:
#   1. EXTRACTED BASE — the cuda*/__cuda* surface of dd's clean-room oracle `dd-gpu/cuda/cudart_shim.c`,
#      produced verbatim by registry/extract_cudart_manifest.py (37 entry points). This is the parity
#      target: same signatures, same behavior/return-codes.
#   2. ADDITIONAL STANDARD SURFACE — widely-used runtime entry points the compact oracle omits, each a
#      real body that forwards to an existing dd-shim-cuda driver `cu*` (so the shipped library is
#      genuinely surface-complete, not a minimal subset). Declared clean-room from the documented public
#      CUDA Runtime API; no NVIDIA source is used.
#
# Every entry point here is hand-implemented in src/runtime.rs (build.rs `IMPLEMENTED`); there are no
# generated stubs (GENERATED_STUBS == 0) — the whole surface has real bodies at oracle parity.

# --- extracted base (dd-gpu/cuda/cudart_shim.c) ---
RT	__cudaPopCallConfiguration	cudaError_t	dim3*|gridDim;dim3*|blockDim;size_t*|sharedMem;void*|stream
RT	__cudaPushCallConfiguration	unsigned int	dim3|gridDim;dim3|blockDim;size_t|sharedMem;void*|stream
RT	__cudaRegisterFatBinary	void**	void*|fatCubin
RT	__cudaRegisterFatBinaryEnd	void	void**|fatCubinHandle
RT	__cudaRegisterFunction	void	void**|fatCubinHandle;const char*|hostFun;char*|deviceFun;const char*|deviceName;int|thread_limit;void*|tid;void*|bid;void*|bDim;void*|gDim;int*|wSize
RT	__cudaRegisterVar	void	void**|fatCubinHandle;char*|hostVar;char*|deviceAddress;const char*|deviceName;int|ext;size_t|size;int|constant;int|global
RT	__cudaUnregisterFatBinary	void	void**|fatCubinHandle
RT	cudaDeviceSynchronize	cudaError_t
RT	cudaDriverGetVersion	cudaError_t	int*|v
RT	cudaEventCreate	cudaError_t	cudaEvent_t*|event
RT	cudaEventCreateWithFlags	cudaError_t	cudaEvent_t*|event;unsigned int|flags
RT	cudaEventDestroy	cudaError_t	cudaEvent_t|event
RT	cudaEventElapsedTime	cudaError_t	float*|ms;cudaEvent_t|start;cudaEvent_t|end
RT	cudaEventRecord	cudaError_t	cudaEvent_t|event;cudaStream_t|stream
RT	cudaEventSynchronize	cudaError_t	cudaEvent_t|event
RT	cudaFree	cudaError_t	void*|devPtr
RT	cudaGetDevice	cudaError_t	int*|device
RT	cudaGetDeviceCount	cudaError_t	int*|count
RT	cudaGetDeviceProperties	cudaError_t	struct cudaDeviceProp*|prop;int|device
RT	cudaGetDeviceProperties_v2	cudaError_t	struct cudaDeviceProp*|prop;int|device
RT	cudaGetErrorName	const char*	cudaError_t|e
RT	cudaGetErrorString	const char*	cudaError_t|e
RT	cudaGetLastError	cudaError_t
RT	cudaLaunchKernel	cudaError_t	const void*|func;dim3|gridDim;dim3|blockDim;void**|args;size_t|sharedMem;cudaStream_t|stream
RT	cudaMalloc	cudaError_t	void**|devPtr;size_t|size
RT	cudaMemGetInfo	cudaError_t	size_t*|freeB;size_t*|totalB
RT	cudaMemcpy	cudaError_t	void*|dst;const void*|src;size_t|count;enum cudaMemcpyKind|kind
RT	cudaMemcpyAsync	cudaError_t	void*|dst;const void*|src;size_t|count;enum cudaMemcpyKind|kind;cudaStream_t|stream
RT	cudaMemset	cudaError_t	void*|devPtr;int|value;size_t|count
RT	cudaMemsetAsync	cudaError_t	void*|devPtr;int|value;size_t|count;cudaStream_t|stream
RT	cudaPeekAtLastError	cudaError_t
RT	cudaRuntimeGetVersion	cudaError_t	int*|v
RT	cudaSetDevice	cudaError_t	int|device
RT	cudaStreamCreate	cudaError_t	cudaStream_t*|pStream
RT	cudaStreamCreateWithFlags	cudaError_t	cudaStream_t*|pStream;unsigned int|flags
RT	cudaStreamDestroy	cudaError_t	cudaStream_t|stream
RT	cudaStreamSynchronize	cudaError_t	cudaStream_t|stream

# --- additional standard runtime surface (driver-backed real bodies; not in the compact oracle) ---
RT	cudaMallocManaged	cudaError_t	void**|devPtr;size_t|size;unsigned int|flags
RT	cudaMallocHost	cudaError_t	void**|ptr;size_t|size
RT	cudaHostAlloc	cudaError_t	void**|ptr;size_t|size;unsigned int|flags
RT	cudaFreeHost	cudaError_t	void*|ptr
RT	cudaHostGetDevicePointer	cudaError_t	void**|pDevice;void*|pHost;unsigned int|flags
RT	cudaGraphicsGLRegisterBuffer	cudaError_t	cudaGraphicsResource**|resource;unsigned int|buffer;unsigned int|flags
RT	cudaGraphicsGLRegisterImage	cudaError_t	cudaGraphicsResource**|resource;unsigned int|image;unsigned int|target;unsigned int|flags
RT	cudaGraphicsMapResources	cudaError_t	int|count;cudaGraphicsResource**|resources;cudaStream_t|stream
RT	cudaGraphicsResourceGetMappedPointer	cudaError_t	void**|devPtr;size_t*|size;cudaGraphicsResource*|resource
RT	cudaGraphicsSubResourceGetMappedArray	cudaError_t	cudaArray**|array;cudaGraphicsResource*|resource;unsigned int|arrayIndex;unsigned int|mipLevel
RT	cudaGraphicsUnmapResources	cudaError_t	int|count;cudaGraphicsResource**|resources;cudaStream_t|stream
RT	cudaGraphicsUnregisterResource	cudaError_t	cudaGraphicsResource*|resource
RT	cudaGraphicsResourceSetMapFlags	cudaError_t	cudaGraphicsResource*|resource;unsigned int|flags
RT	cudaImportExternalSemaphore	cudaError_t	void**|externalSemaphore_out;const void*|semHandleDesc
RT	cudaDestroyExternalSemaphore	cudaError_t	void*|extSem
RT	cudaSignalExternalSemaphoresAsync	cudaError_t	void**|extSemArray;const void*|paramsArray;unsigned int|numExtSems;cudaStream_t|stream
RT	cudaWaitExternalSemaphoresAsync	cudaError_t	void**|extSemArray;const void*|paramsArray;unsigned int|numExtSems;cudaStream_t|stream
RT	cudaGLSetGLDevice	cudaError_t	int|device
RT	cudaDeviceReset	cudaError_t
RT	cudaThreadSynchronize	cudaError_t
RT	cudaStreamWaitEvent	cudaError_t	cudaStream_t|stream;cudaEvent_t|event;unsigned int|flags
RT	cudaStreamQuery	cudaError_t	cudaStream_t|stream
RT	cudaEventQuery	cudaError_t	cudaEvent_t|event
RT	cudaFuncGetAttributes	cudaError_t	struct cudaFuncAttributes*|attr;const void*|func
RT	cudaDeviceGetPCIBusId	cudaError_t	char*|pciBusId;int|len;int|device
