# NVML entry-point manifest for the hl-cuda nvml guest shim (libnvidia-ml.so.1).
# Extracted from the clean-room NVML oracle hl-gpu/nvml/nvml_shim.c (its exported nvml* surface).
# Format: NVML<TAB>name<TAB>ret<TAB>params  (params = `ctype|pname` joined by ";"; empty for void).
# Consumed by build.rs to code-generate the #[no_mangle] extern "C" export surface. Every entry is a
# benign truthful stub (NVML_SUCCESS / null string) — device-info surface, not a compute path.

NVML	nvmlInit_v2	nvmlReturn_t	
NVML	nvmlInit	nvmlReturn_t	
NVML	nvmlInitWithFlags	nvmlReturn_t	unsigned int|f
NVML	nvmlShutdown	nvmlReturn_t	
NVML	nvmlErrorString	const char*	nvmlReturn_t|r
NVML	nvmlSystemGetDriverVersion	nvmlReturn_t	char*|v;unsigned int|len
NVML	nvmlSystemGetNVMLVersion	nvmlReturn_t	char*|v;unsigned int|len
NVML	nvmlSystemGetCudaDriverVersion	nvmlReturn_t	int*|v
NVML	nvmlSystemGetCudaDriverVersion_v2	nvmlReturn_t	int*|v
NVML	nvmlDeviceGetCount_v2	nvmlReturn_t	unsigned int*|c
NVML	nvmlDeviceGetCount	nvmlReturn_t	unsigned int*|c
NVML	nvmlDeviceGetHandleByIndex_v2	nvmlReturn_t	unsigned int|i;nvmlDevice_t*|d
NVML	nvmlDeviceGetHandleByIndex	nvmlReturn_t	unsigned int|i;nvmlDevice_t*|d
NVML	nvmlDeviceGetHandleByUUID	nvmlReturn_t	const char*|uuid;nvmlDevice_t*|dev
