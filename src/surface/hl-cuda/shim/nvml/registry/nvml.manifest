NVML	nvmlDeviceGetHandleByPciBusId	nvmlReturn_t	const char*|p;nvmlDevice_t*|d
NVML	nvmlDeviceGetName	nvmlReturn_t	nvmlDevice_t|d;char*|name;unsigned int|len
NVML	nvmlDeviceGetUUID	nvmlReturn_t	nvmlDevice_t|d;char*|uuid;unsigned int|len
