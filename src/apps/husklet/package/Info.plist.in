<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>         <string>husklet</string>
  <key>CFBundleIdentifier</key>         <string>@APPLICATION_ID@</string>
  <key>CFBundleName</key>               <string>Husklet</string>
  <key>CFBundleDisplayName</key>        <string>Husklet</string>
  <key>CFBundlePackageType</key>        <string>APPL</string>
  <key>CFBundleShortVersionString</key> <string>@VERSION@</string>
  <key>CFBundleVersion</key>            <string>@VERSION@</string>
  <!-- The revision this bundle was built from, and whether the tree was dirty. A measurement bound only to
       content hashes cannot be tied back to source, which is how a conformance run ends up unattributable. -->
  <key>HLSourceRevision</key>           <string>@REVISION@</string>
  <key>HLSourceChanges</key>            <string>@CHANGES@</string>
  <key>CFBundleIconFile</key>           <string>husklet.icns</string>
  <key>NSHighResolutionCapable</key>    <true/>
  <key>LSMinimumSystemVersion</key>     <string>12.0</string>
  <key>NSPrincipalClass</key>           <string>NSApplication</string>
  <key>LSApplicationCategoryType</key>  <string>public.app-category.developer-tools</string>
</dict>
</plist>
