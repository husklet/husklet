/target/
node_modules/
**/target/
# These are C source directories, not Cargo build output.
!src/runtime/hl-native/src/native/engine/target/
!src/runtime/hl-native/src/native/engine/target/**
/artifacts/
*.o
dd.sock
**/.bench-cache/
__pycache__/
*.py[cod]
/target-mac/
/target-bench/
/test.db
/target-*
# Claude Code worktrees + transcripts
.claude/

# maintainer/agent local dev helpers (never committed)
.dev/
docs/
skills-lock.json
target-*/
/pclib_blob_*.bin

# in-repo scratch / worktree mirrors / build output (never committed)
.scratch*
.shatmp/
.wt-*/
dd-tests/compliance/ltp/out/

# Reference implementations (local-only, cloned to study upstream APIs)
reference/

# pcachex libmap test generates these at runtime (O_CREAT); never commit them
pclib_blob_*.bin
.agents

# Scenario runs write per-run logs and result streams here; they are run output, not sources.
**/.cache/scenario-runs/

# `nix run .#lint-cases` regenerates these review queues from scratch; they are tool output.
/lint/errors/*
!/lint/errors/.gitkeep
/lint/check/*
!/lint/check/.gitkeep

# Compatibility ledgers create these transiently and remove them after a complete run.
/tests/runtime/legacy/report/*.lock
/tests/runtime/legacy/report/*.partial.tsv
